# Copy this file to .env.development and edit for your local setup.
# When running on a phone or another device on the LAN, replace localhost
# with your computer's LAN IP, e.g. 192.168.1.100.
VITE_API_BASE_URL=https://api.careerloop.top
# Leave empty until the website passport is exposed through a certificate-trusted
# HTTPS domain. HTTP, IP-literal and localhost entries are deliberately disabled.
VITE_WEBSITE_PASSPORT_URL=
